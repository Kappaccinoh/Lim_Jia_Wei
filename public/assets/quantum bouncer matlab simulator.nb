Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Quantum", " ", "Bouncer"}], "\[Dash]", 
    RowBox[{
     RowBox[{"Part", " ", 
      RowBox[{"(", "c", ")"}]}], ":", 
     RowBox[{"Expectation", " ", "of", " ", "Energy"}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "=="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"assumptions", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Sigma]0\:200b", ">", "0"}], ",", 
       RowBox[{"Element", "[", 
        RowBox[{"z0", ",", "Reals"}], "]"}], ",", 
       RowBox[{"m", ">", "0"}], ",", 
       RowBox[{"g", ">", "0"}], ",", 
       RowBox[{"\[HBar]", ">", "0"}]}], "}"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"normalised", " ", "Gaussian", " ", "on", " ", "\:211d"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"psi", "[", "z_", "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"2", " ", "Pi"}], "]"}], " ", "\[Sigma]0\:200b"}], "]"}]}], 
      "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"z", "-", "z0"}], ")"}], "^", "2"}]}], "/", 
        RowBox[{"(", 
         RowBox[{"4", " ", 
          RowBox[{"\[Sigma]0\:200b", "^", "2"}]}], ")"}]}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"normCheck", "=", 
     RowBox[{"Assuming", "[", 
      RowBox[{"assumptions", ",", 
       RowBox[{"Simplify", "@", 
        RowBox[{"Integrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"psi", "[", "z", "]"}], "^", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"z", ",", 
            RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{
     "\"\<Integral of Gaussian from -inf to inf = \>\"", ",", "normCheck"}], 
     "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", 
    "\"\<Hence conclude that the initial Gaussian is already normalised \
properly\>\"", "]"}], "\[IndentingNewLine]"}]}]], "Input",
