       RowBox[{
        RowBox[{"(", 
         RowBox[{"x", "-", "a"}], ")"}], "^", "2"}], " ", "dx"}]}]}], ",", 
    RowBox[{"with", " ", "a", " ", "a", " ", "zero", " ", "of", " ", "Ai", 
     RowBox[{"(", 
      RowBox[{"-", "x"}], ")"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"intAi", "=", 
   RowBox[{"Assuming", "[", 
