Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "=="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Quantum", " ", "bouncer"}], "\[LongDash]", 
    RowBox[{
     RowBox[{"Part", " ", 
      RowBox[{"(", "f", ")"}]}], ":", "Animation"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "=="}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{
       RowBox[{"scales", "--"}], "--"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[ScriptL]g", ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[HBar]", "^", "2"}], "/", 
        RowBox[{"(", 
         RowBox[{"2", " ", 
          RowBox[{"m", "^", "2"}], " ", "g"}], ")"}]}], ")"}], "^", 
      RowBox[{"(", 
       RowBox[{"1", "/", "3"}], ")"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Omega]0", ":=", 
     RowBox[{"m", " ", "g", " ", 
      RowBox[{"\[ScriptL]g", "/", "\[HBar]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{
       RowBox[{"eigenpairs", "--"}], "--"}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Epsilon]", "[", 
      RowBox[{"n_Integer", "?", "Positive"}], "]"}], ":=", 
     RowBox[{"-", 
      RowBox[{"AiryAiZero", "[", "n", "]"}]}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"\[CurlyEpsilon]_n", ">", "0"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"normFactor", "[", "n_", "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", "\[ScriptL]g", "]"}]}], "/", 
      RowBox[{"Abs", "[", 
       RowBox[{"AiryAiPrime", "[", 
        RowBox[{"-", 
         RowBox[{"\[Epsilon]", "[", "n", "]"}]}], "]"}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"normalised", " ", "eigenfunctions"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Phi]", "[", 
      RowBox[{
       RowBox[{"n_Integer", "?", "Positive"}], ",", "z_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"normFactor", "[", "n", "]"}], " ", 
      RowBox[{"AiryAi", "[", 
       RowBox[{
        RowBox[{"z", "/", "\[ScriptL]g"}], "-", 
        RowBox[{"\[Epsilon]", "[", "n", "]"}]}], "]"}], " ", 
