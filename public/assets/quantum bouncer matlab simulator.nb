  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "\[Psi]", ",", "x", ",", "m", ",", "g", ",", "ellg", ",", "\[HBar]", ",",
       "En", ",", "\[Epsilon]"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "convert", " ", "Schr\[ODoubleDot]dinger", " ", "equation", " ", "in", 
     " ", "x", " ", "so", " ", "that", " ", "its", " ", "dimensionless"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"subeq", "=", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"\[HBar]", "^", "2"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "m", " ", 
             RowBox[{"ellg", "^", "2"}]}], ")"}]}], ")"}]}], " ", 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"\[Psi]", "[", "x", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "2"}], "}"}]}], "]"}]}], "+", 
       RowBox[{"m", " ", "g", " ", "ellg", " ", "x", " ", 
        RowBox[{"\[Psi]", "[", "x", "]"}]}]}], "==", 
      RowBox[{"En", " ", 
       RowBox[{"\[Psi]", "[", "x", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"solve", " ", "the", " ", "differential", " ", "equation"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"sol", "=", 
     RowBox[{"DSolve", "[", 
      RowBox[{"subeq", ",", "\[Psi]", ",", "x"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"extract", " ", 
     RowBox[{"\[Psi]", "[", "x", "]"}], " ", "from", " ", "the", " ", 
     "solution"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"psiRaw", "[", "x_", "]"}], "=", 
     RowBox[{
      RowBox[{"\[Psi]", "[", "x", "]"}], "/.", " ", 
      RowBox[{"sol", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"psiFinal", "[", "x_", "]"}], "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"psiRaw", "[", "x", "]"}], "/.", " ", 
        RowBox[{"En", "->", 
