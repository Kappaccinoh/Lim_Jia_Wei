      RowBox[{"(", 
       RowBox[{"4", " ", 
        RowBox[{"\[Sigma]0\:200b", "^", "2"}]}], ")"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"assumptions", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Sigma]0\:200b", ">", "0"}], ",", 
      RowBox[{"Element", "[", 
       RowBox[{"z0", ",", "Reals"}], "]"}], ",", 
      RowBox[{"m", ">", "0"}], ",", 
      RowBox[{"g", ">", "0"}], ",", 
      RowBox[{"\[HBar]", ">", "0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"get", " ", "expectation", " ", "of", " ", "position"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zExp", "=", 
