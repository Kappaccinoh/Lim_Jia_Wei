      RowBox[{"Integrate", "[", 
       RowBox[{
        RowBox[{"z", " ", 
         RowBox[{
          RowBox[{"psi", "[", "z", "]"}], "^", "2"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"z", ",", 
          RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
