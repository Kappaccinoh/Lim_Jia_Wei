      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "4"}], "}"}]}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "15"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"\"\<n = \>\"", "<>", 
