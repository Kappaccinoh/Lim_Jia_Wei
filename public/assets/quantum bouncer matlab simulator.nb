Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"aPos", ",", "\[Psi]n", ",", "x"}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Airy", " ", 
     RowBox[{"zeros", ":", 
      RowBox[{"a_n", ">", 
       RowBox[{"0", " ", "with", " ", "Ai", 
        RowBox[{"(", 
         RowBox[{"-", "a_n"}], ")"}]}]}]}]}], "=", "0"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"aPos", "[", "n_", "]"}], ":=", 
    RowBox[{"-", 
     RowBox[{"AiryAiZero", "[", "n", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"normalised", " ", "eigenfunction", " ", "\[Psi]_n", 
     RowBox[{"(", "x", ")"}]}], "=", 
    RowBox[{
     RowBox[{"Ai", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", "-", "a_n"}], ")"}], "/"}]}], "|", 
     RowBox[{
      RowBox[{"Ai", "'"}], 
      RowBox[{"(", 
       RowBox[{"-", "a_n"}], ")"}]}], "|"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]n", "[", 
     RowBox[{"n_", ",", "x_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"AiryAi", "[", 
      RowBox[{"x", "-", 
       RowBox[{"aPos", "[", "n", "]"}]}], "]"}], "/", 
     RowBox[{"Abs", "[", 
      RowBox[{"AiryAiPrime", "[", 
       RowBox[{"-", 
        RowBox[{"aPos", "[", "n", "]"}]}], "]"}], "]"}]}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"\[Psi]n", "[", 
